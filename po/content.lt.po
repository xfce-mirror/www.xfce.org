msgstr ""

#. type: Plain text
#: content/about/tour420.md:52
msgid "By using different container types, the \"Exo-Icon-View\" now can handle 100,000 files and more without freezing."
msgstr ""

#. type: Title ###
#: content/about/tour420.md:54
msgid "Type ahead search box"
msgstr ""

#. type: Plain text
#: content/about/tour420.md:56
msgid "The type ahead search box in the exo icon view now always stays inside the according view widget."
msgstr ""

#: content/about/tour420.md:58
msgid "[libxfce4ui](https://docs.xfce.org/xfce/libxfce4ui/start)"
msgstr ""

#. type: Title ###
#: content/about/tour420.md:60
msgid "Shortcut Editor"
msgstr ""

#. type: Plain text
#: content/about/tour420.md:62
msgid "Shortcuts now can be used for multiple actions if they don't conflict with each other."
msgstr ""

#. type: Title ###
#: content/about/tour420.md:64
msgid "About Dialog"
msgstr "„Apie“ dialogas"

#. type: Plain text
#: content/about/tour420.md:66
msgid "The dialog now shows the distribution logo, information about the used windowing system and the used GPU."
