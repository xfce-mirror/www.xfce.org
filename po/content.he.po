msgstr "[הורדה](http://archive.xfce.org/xfce/4.6.2/)"

#. type: Plain text
#: content/about/tour420.md:382
msgid "Support for stretch theme variants"
msgstr "תמיכה בוארינטים נמתחים של ערכת נושא"

#. type: Plain text
#: content/about/tour420.md:384
msgid "Compositor: Block softpipe for GLX vsync"
msgstr "עורך: חסימת softpipe for GLX vsync"

#. type: Plain text
